
# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# LinkedIn OAuth2 access token — see linkedin_poster.py (one-time auth flow)
LINKEDIN_TOKEN=your_linkedin_token_here

# Stability AI API key for image generation — https://platform.stability.ai
STABILITY_AI=sk-your_stability_ai_key_here

# LinkedIn OAuth App credentials — from the LinkedIn Developer Portal
CLIENT_ID=your_linkedin_client_id_here
CLIENT_SECRET=your_linkedin_client_secret_here
